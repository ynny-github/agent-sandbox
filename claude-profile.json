{
  // The nono profile the launched agent itself runs under. agent-sandbox does
  // not generate, read, or validate this file — it hands the path to nono.
  //
  // Scope: the agent process and its DIRECT children (an MCP server it spawns
  // is not routed through execd). Shell commands do not run here at all: they
  // go through execd, under command-profile.json. Nothing needed only to *run
  // a command* belongs in this file.
  // You do not grant the agent-sandbox binary here. The agent runs
  // `agent-sandbox hook` and `agent-sandbox serve` as its own direct children,
  // so it must be able to exec that binary — but only the launcher knows where
  // it lives (a mise-managed toolchain puts the Go version in the path), so it
  // passes `--read-file <its own path>` on the nono command line instead.
  "extends": "claude",
  "meta": { "name": "custom claude" },

  // NixOS: every executable lives under /nix/store, reached through the
  // /run/current-system/sw symlink farm. nono's base profile grants that tree
  // read but not execute, so without this the agent cannot start at all —
  // execve is refused and the process exits 127 with no output.
  "groups": { "include": ["nix_runtime"] },

  "filesystem": {
    // The agent's file tools write scratch files here and read them back; the
    // claude base grants /tmp write-only, which fails on the read-back. In mcp
    // mode this also covers mcp.command_output_dir.
    "allow": ["/tmp"],

    "read": [
      "/nix/store",
      "/run/current-system/sw",
      // An MCP server the agent spawns runs as a DIRECT child of the agent,
      // not through execd, so a server started with `docker run ...`
      // reads its docker config here rather than in the command profile.
      // agent-sandbox no longer configures an MCP server of its own; these
      // are carried for one the operator adds via `claude --mcp-config`.
      // Nothing in this repository depends on them today, so they are the
      // first thing to drop if no docker-run MCP server is ever configured.
      // Not the same grant as the command profile's own `~/.docker`, which
      // belongs to the `docker` command execd runs.
      "~/.docker",
      "~/.orbstack"
    ],

    // There is deliberately no ~/.bashrc grant, and no read_file key at all.
    //
    // It used to be here, with a bypass_protection entry beside it, because
    // every tool result was prefixed with bash complaining it could not read
    // the file. The cause was not that Claude asks bash to read it: Claude
    // spawns the shell with a SOCKET on stdin, and non-interactive bash treats
    // a socket on stdin as "I was started by rshd/sshd" and sources ~/.bashrc.
    // Measured on bash 5.3.9 by varying only stdin: socket -> sourced, pipe ->
    // not sourced. BASH_ENV, ENV, SHELLOPTS=posix and POSIXLY_CORRECT do not
    // suppress it; only the --norc startup flag does.
    //
    // agent-sandbox therefore generates a shell wrapper at launch that is bash
    // with --norc --noprofile bolted on, grants it with --read-file, and names
    // it in CLAUDE_CODE_SHELL (see internal/claude/shellwrapper.go and the
    // allow_vars entry below). Nothing in the sandbox reads the rc any more, so
    // the grant is gone — and with it the mise read grants, which existed only
    // because ~/.bashrc ends in `eval "$(mise activate bash --shims)"`.
    //
    // If that wrapper ever stops reaching Claude, the symptom is the old noise
    // returning, not a broken session. `agent-sandbox doctor` measures it.

    "allow_file": ["/dev/null"],
    "bypass_protection": ["~/.docker"]
  },

  "environment": {
    // AGENT_SANDBOX_EXECD_SOCKET is load-bearing. Without it nono strips the
    // variable, the agent never reaches execd, and EVERY command fails
    // with an error that names nothing. `agent-sandbox doctor` probes for it
    // because nono cannot report env grants: `nono profile show` does not
    // print allow_vars and `nono why` has no env query.
    //
    // CLAUDE_CODE_SHELL names the wrapper the launcher generates for this
    // session (see the filesystem comment above). nono strips it otherwise —
    // measured: `printenv CLAUDE_CODE_SHELL` inside the sandbox prints nothing
    // without this entry — and Claude then falls back to the login shell from
    // /etc/passwd, which brings the ~/.bashrc noise back. What this opens: an
    // operator-set variable now chooses the binary the agent runs tool commands
    // with. PATH, already forwarded, decides the same class of thing, so this
    // is not a new kind of inlet — but it is one more.
    //
    // CONTEXT_MODE_EXEC_BACKEND selects context-mode's execution backend for a
    // session launched with `--context-mode`. Measured: with the variable set
    // on the host but absent from this list, `printenv
    // CONTEXT_MODE_EXEC_BACKEND` inside the sandbox prints nothing — and
    // context-mode reads an absent variable as "local", running agent-authored
    // code in this profile instead of under the command profile, with nothing
    // in the session saying so. The launcher probes for it and refuses to start
    // when it does not arrive.
    //
    // It is inert without the flag: nothing sets the variable, so nothing is
    // forwarded.
    //
    // --env no longer grants anything. A variable passed that way reaches the
    // agent only if it is listed here (globs like MISE* work).
    "allow_vars": [
      "PATH", "HOME", "TERM", "LANG", "LC_ALL", "USER",
      "AGENT_SANDBOX_EXECD_SOCKET", "CLAUDE_CODE_SHELL",
      "CONTEXT_MODE_EXEC_BACKEND"
    ]
  }
}

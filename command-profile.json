{
  // Written by hand, in nono's own schema: agent-sandbox does not generate,
  // read, or validate this file. What a brokered command may access is
  // decided by this file alone, together with nono's own base profiles.
  //
  // The section headings below group the grants the same way the deleted
  // capability catalog used to (go, python, node, rust, dart, flutter,
  // docker, ssh, mise, bashrc), so a grant can still be traced back to the
  // toolchain it serves. There is no longer a catalog.go this file tracks —
  // when a toolchain needs a new path, this file is where it gets added.

  "meta": { "name": "agent-sandbox commands (this repository)" },

  "groups": {
    "include": [
      // -- baseline (baselineGroups; granted whatever the capability list says)
      "nix_runtime",      // NixOS: /nix/store is where every executable lives

      // -- one group per runtime capability
      "go_runtime",       // capability: go
      "python_runtime",   // capability: python
      "node_runtime",     // capability: node
      "rust_runtime",     // capability: rust
      "mise_manager"      // capability: mise (read side; env vars below)
      // dart, flutter and bashrc have no nono group — they spell out their
      // paths in filesystem below. docker and ssh have no nono group
      // either, but neither spells its paths out in filesystem any more:
      // both are declared commands now, and spell their paths out under
      // command_policies.commands instead.
    ]
  },

  "filesystem": {
    "allow": [
      // -- not from the catalog: this profile's own session grants
      "$WORKDIR",
      "~/.local/state/agent-sandbox",
      "/tmp",                                  // scratch space floor commands may need (uv, npm, pip, mise, ...) —
                                                // NOT why go test works: go is a policy command below now, with its
                                                // own separate /tmp grant, and compiles into/execs from that one

      // -- capability: go   (groups are read-only, so the caches are named here)
      "~/go/pkg/mod",
      "$XDG_CACHE_HOME/go-build",              // catalog perOSAllow.linux; darwin uses ~/Library/Caches/go-build

      // -- capability: python
      "$XDG_CACHE_HOME/uv",
      "~/.local/share/uv/python",              // uv's managed interpreters
      "$XDG_CACHE_HOME/pip",                   // catalog perOSAllow.linux; darwin uses ~/Library/Caches/pip

      // -- capability: node
      "~/.npm",
      "~/.local/share/pnpm",                   // catalog perOSAllow.darwin adds ~/Library/pnpm

      // -- capability: rust
      "~/.cargo/registry",
      "~/.cargo/git",
      // NOTE: rust_runtime grants all of ~/.cargo, publish token included, so
      // a brokered command can read it. There is no deny layer on this side
      // (or the agent's) that would hide it — this file is the only thing
      // that decides what a brokered command may read.

      // -- capability: dart
      "~/.pub-cache",
      "~/.dart",
      "~/.dart-tool",                          // dartdev writes analytics config here on startup
      // NOTE: ~/.dart-tool also holds pub-tokens.json (private repo
      // credentials), same as rust above — read access to it is decided by
      // this file alone.

      // -- capability: flutter
      "~/.config/flutter",
      "~/.local/share/mise/http-tarballs"
      // NOTE: this is a WRITE grant over every mise-installed binary, including
      // agent-sandbox itself. doctor's "broker binary is not writable" check will
      // fail while this line is present. Drop the flutter capability unless a
      // project actually needs it.
    ],

    "read": [
      // -- not from the catalog: NixOS execution precondition
      "/nix/store",
      "/run/current-system/sw",

      // -- capability: mise
      "~/.local/share/mise",
      "~/.config/mise"
    ],

    "read_file": [
      // -- capability: bashrc
      "~/.bashrc",
      "/etc/bashrc",
      "/etc/bash.bashrc"
      // NOTE: bash and sh are declared commands now, but a floor read_file
      // grant does not propagate into their child sandboxes, so nothing here
      // reads these. Carried only because the capability defines them.
    ],

    "allow_file": [
      // -- baseline (baselineAllowFile)
      "/dev/null"
    ],

    "bypass_protection": [
      // catalog `bypass`: these prefixes are protected by nono, and a grant
      // against one is refused without this opt-in.
      "~/.bashrc"                              // capability: bashrc
    ],

    // Paired with "linux": { "af_unix_mediation": "pathname" } below — see
    // that key's comment for what the pair is carried for and what it does
    // not yet do. This grant is mandatory the moment mediation is
    // "pathname", not redundant with the plain "~/.local/state/agent-sandbox"
    // entry under "allow" above: pathname mediation gates AF_UNIX *bind* as
    // well as connect, and the broker binds its own socket in this same
    // directory at startup. Measured on nono 0.74.0, with mediation set to
    // "pathname" and this entry absent: the broker fails to bind its
    // socket and the whole system fails to start. Do not delete this
    // thinking the "allow" entry already covers it — that one is a plain
    // path grant with no bearing on bind once mediation is on; this one is
    // the bind grant mediation specifically requires, and both are needed.
    "unix_socket_dir_bind": ["~/.local/state/agent-sandbox"]
  },

  "environment": {
    "allow_vars": [
      // -- baseline (baselineEnv)
      "PATH", "HOME", "TERM", "LANG", "LC_ALL", "USER",

      // -- capability: mise
      "MISE*", "__MISE*",

      // -- capability: dart
      "PUB_CACHE", "PUB_HOSTED_URL",

      // -- capability: flutter
      "FLUTTER_ROOT", "FLUTTER_STORAGE_BASE_URL",

      // -- not from the catalog: proxy variables this profile carries itself
      "http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY", "no_proxy", "NO_PROXY"

      // DO NOT add AGENT_SANDBOX_BROKER_SOCKET, and do not add a wildcard that
      // would match it. It is agentOnlyEnv: a command that can reach the broker
      // socket can recurse into broker.Server.Serve, which spawns handlers with
      // no concurrency cap — a host-side fork bomb. ResolveShell used to be the
      // code that kept it out of this profile; that code is gone, so this list
      // being explicit is the only thing left enforcing it.
    ]
  },

  "network": {
    "allow_domain": [
      // -- common to every toolchain: source and release artefacts
      "github.com",
      "*.githubusercontent.com",        // raw. and objects. (release assets, uv's CPython builds)
      "codeload.github.com",            // tarball/zipball downloads: go get direct, pip/uv "git+" archives, mise

      // -- capability: go
      "proxy.golang.org",
      "sum.golang.org",

      // -- capability: python
      "pypi.org",
      "files.pythonhosted.org",

      // -- capability: node
      "registry.npmjs.org",

      // -- capability: rust
      "index.crates.io",                // the sparse index cargo resolves against
      "static.crates.io",               // the .crate files themselves

      // -- capability: dart
      "pub.dev",

      // -- capability: flutter
      "storage.googleapis.com",         // SDK and engine artefacts
      // "storage.flutter-io.cn" is the China mirror; add only if FLUTTER_STORAGE_BASE_URL points there.

      // -- capability: mise
      "mise.jdx.dev",                   // version/registry metadata
      "api.github.com"                  // release listings mise resolves tools through
    ]
  },

  // The hole this is carried for: Tool Sandbox's child sandboxes carry NO
  // AF_UNIX mediation at all on this host's nono, so any declared command's
  // child can speak to host unix sockets, docker.sock included, which is
  // root-equivalent. Measured on nono 0.74.0: the FLOOR mediates it —
  // `curl -s --unix-socket /var/run/docker.sock http://localhost/version`,
  // run at the floor, is refused ("no matching unix_socket capability",
  // exit 7) — but the identical curl, run through `bash -c` or `sh -c`
  // (both declared commands below, neither one named docker), reaches the
  // daemon and prints its version JSON. Not about the `docker` name: a raw
  // python3 AF_UNIX connect to the same socket from inside `bash`, no
  // docker binary involved anywhere, reaches it too. `bash -c 'docker ps'`
  // is already refused by can_use — that is a different, and much
  // narrower, guarantee than "the socket is gated."
  //
  // "af_unix_mediation": "pathname" is nono's session-level switch for
  // AF_UNIX mediation, default Off. It is session-wide by construction, not
  // per-command: a command policy's own child sandbox ("sandbox" object
  // under command_policies.commands above) has no connect-side field of
  // its own to express this — nono's CommandSandboxConfig carries only
  // unix_socket_bind (a bind grant, not a connect gate), and only since
  // nono 0.76.0 (PR #1780). On 0.74.0, the child schema does not have that
  // field at all, so there is no per-command way to ask for connect-side
  // mediation even if this switch is flipped on.
  //
  // Consequently: on this host, TODAY, with nono 0.74.0, the hole above is
  // STILL OPEN with this key present. Measured, 3/3 runs: with this line
  // and the matching filesystem.unix_socket_dir_bind grant above both
  // applied, `bash -c '<the curl above>'` still reaches the daemon and
  // prints its version JSON, unchanged from before this key existed. This
  // key is carried for the nono version this repository intends to move
  // to, on the premise that a session-level switch plus a future
  // connect-side child field closes it there — that outcome is NOT
  // verified here. nono 0.77.0 builds on this host but cannot start Tool
  // Sandbox at all on NixOS ("failed to resolve ELF dependency
  // 'libgcc_s.so.1' for .../shims/bash"); tmp/nono-nixos-elf-fix.patch
  // applies cleanly to 0.77.0 and is correctly wired in, and even so no
  // longer fixes that failure. And 0.77.0's own child schema still only
  // has unix_socket_bind — no connect side — so a per-child connect rule
  // remains inexpressible there too. Do not read this key's presence as a
  // claim that upgrading nono will close the hole; it states the mechanism
  // and carries it forward, nothing more.
  "linux": { "af_unix_mediation": "pathname" },

  "command_policies": {
    "commands": {
      // DO NOT shorten "from": {"session": …} to the "sandbox" shorthand. nono
      // runs both identically, but `nono why --profile <this> --command git`
      // does not implement the shorthand: it answers DENIED / missing
      // from.session for a command that demonstrably runs. `ai explain` tells
      // the agent to run exactly that query, so the false denial would reach
      // the agent unmediated. Measured on nono 0.74.0.
      //
      // DO NOT pin "executable" here either. A pin whose path does not exist
      // disables mediation for the command entirely: nono falls back to the
      // first PATH match and runs it at the SESSION's grants, `nono profile
      // validate` still passes, and the audit records "tools: active, no
      // invocations". This is not silent — nono prints "[nono] Warning: 1
      // command policy not found on PATH, skipping: <name>", and --silent
      // does not suppress it — but the warning is easy to miss in a wall of
      // launch output, and the danger it names is real. git's path is a
      // /nix/store path that changes on every nixpkgs update, so a pin here
      // would un-sandbox git on the next upgrade. Measured on nono 0.74.0.
      // `agent-sandbox doctor` checks the paths below still exist for the
      // same reason.
      //
      // Git hooks do NOT execute from this sandbox. `git commit` fails with
      // "fatal: cannot exec '.git/hooks/commit-msg': Permission denied";
      // use `git commit --no-verify`.
      //
      // Making them execute would need $WORKDIR and /nix/store added to this
      // exec_paths below (a hook's shebang makes the kernel exec the
      // interpreter, under /nix/store, as part of git's own execve() of the
      // hook file). This is deliberately NOT done — on the benefit argument
      // alone, which is decisive by itself: enabling hooks buys back
      // nothing. Measured, with hooks temporarily enabled for the test:
      // lefthook still did not run, and a commit message that violates this
      // repo's Conventional Commits rule was accepted unvalidated here,
      // while the identical message was rejected outside nono. The reason
      // lefthook did not run was not isolated (this repo's hook tries a
      // plain `lefthook` on PATH before falling back to a version-stamped
      // absolute path; either could be the one failing) — do not assume a
      // mechanism and do not "fix" one without re-measuring first. Net
      // effect, with or without hooks executing: commit-message validation
      // does NOT run inside this sandbox. Do not re-open the hook-execution
      // path to try to fix that — it was tried, it does not fix it.
      // Measured on nono 0.74.0.
      //
      // The security argument does not carry this on its own: the floor
      // already has a write-then-execute path of its own — a Go binary
      // built into $WORKDIR runs at the floor. Its network reach is the
      // SAME as this sandbox's, not larger: a child's "network" key is an
      // on/off switch for nono's own local proxy, and the proxy filters
      // against the SESSION's top-level network.allow_domain, not the
      // child's own declared list — measured, this sandbox's declared
      // ["github.com", "*.githubusercontent.com"] notwithstanding, from
      // inside it: `git ls-remote https://pypi.org/...` reaches pypi.org
      // (session-listed, not here) and gets pypi's own 404, while
      // `https://example.com/...` is refused by the proxy outright (listed
      // in neither). So widening exec_paths here to $WORKDIR + /nix/store
      // would add no new class of capability, network included. Measured.
      // The one genuine delta it would
      // cost: arbitrary code running in git's child sandbox would gain read
      // access to the global gitconfig, which the floor does NOT have
      // (`path_not_granted` at the floor; measured). Also measured, with
      // exec_paths temporarily widened in a throwaway build of this profile
      // (NOT the shipped state above — that widening was reverted; see
      // commits 258b9a9 and 45eb9fa): a hand-written
      // `.git/hooks/pre-commit` ran and printed its own output inside git's
      // sandbox.
      "git": {
        "can_use": ["ssh"],
        "from": {
          "session": { "sandbox": {
            // Global/system git config plus the declared target of every
            // include.path / includeIf.*.path in those scopes. local and worktree
            // scopes are deliberately excluded by nono, so a repository cannot
            // grant itself host access through its own .git/config.
            "fs_read_file": ["@git:config-files"],
            "fs_read":      ["@git:hooks-path", "$WORKDIR", "/nix/store", "/run/current-system/sw"],
            // @git:common-dir covers the object store when $WORKDIR is a linked
            // worktree; @git:worktree covers the main repo root, without which
            // `git worktree add` fails at getcwd() with EPERM.
            "fs_write":     ["$WORKDIR", "@git:common-dir", "@git:worktree", "@git:toplevel"],
            // Needed ONLY for HTTPS transport: git-remote-https is a separate
            // binary under libexec/git-core. Without this, local operations and
            // SSH remotes still work and HTTPS fails with
            // "fatal: cannot exec 'remote-https': Permission denied".
            // nono SKIPS exec_paths entries that do not exist, so a nixpkgs git
            // update breaks HTTPS here silently. doctor checks for that.
            // /usr/lib/git-core and /usr/libexec/git-core are also listed,
            // unconditionally: a missing entry costs nothing (skipped, same
            // as a stale nix hash would be), and having them means HTTPS
            // transport also works on a non-Nix host — this file is not
            // NixOS-only.
            "exec_paths":   ["/nix/store/8yh8zbb0r4na7gkqk0db0gbdid2ax7zm-git-2.54.0/libexec/git-core",
                              "/usr/lib/git-core", "/usr/libexec/git-core"],
            // Governs HTTPS remotes only; SSH remotes go out through the ssh
            // entry below. This "network" key is an on/off switch for
            // nono's own local proxy, not a narrower allowlist: the proxy
            // filters against the SESSION's own top-level
            // network.allow_domain (14 hosts), not the list declared here.
            // Measured: from inside this sandbox, `git ls-remote` reaches
            // pypi.org (session-listed, not in the two domains below) and
            // is refused example.com (in neither list). What actually
            // gates HTTPS here is (a) this key being present at all, and
            // (b) the six proxy env vars just below being forwarded, so
            // the child can find nono's local proxy — which in turn
            // requires the session's own top-level network block to stay
            // present: a child "network" key against a proxy-less session
            // fails at init with "no loopback proxy env was present".
            "network":      { "allow_domain": ["github.com", "*.githubusercontent.com"] },
            "environment":  { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM",
                                             "http_proxy", "HTTP_PROXY", "https_proxy",
                                             "HTTPS_PROXY", "no_proxy", "NO_PROXY"] }
          } }
        }
      },

      // The only reason ~/.ssh can come off the floor. Reachable from git and
      // from nothing else: direct session ssh is refused with exit 126.
      "ssh": {
        "from": {
          "session": "deny",
          "git": { "sandbox": {
            // The official git-ssh example brokers $SSH_AUTH_SOCK as a
            // local-socket credential and prefers that to a raw key grant. Not
            // usable here: SSH_AUTH_SOCK is set on this host but points at a
            // socket that no longer exists, and a profile declaring the
            // credential fails before launch. If a live agent ever becomes
            // standard, replace the id_main grant with:
            //   "credentials": { "ssh-agent": { "type": "local-socket",
            //     "path": "$SSH_AUTH_SOCK", "mode": "connect",
            //     "env_var": "SSH_AUTH_SOCK" } }
            // at command_policies level, and "use_credentials": ["ssh-agent"] here.
            "fs_read_file":  ["~/.ssh/id_main", "~/.ssh/config", "~/.ssh/known_hosts"],
            "fs_write_file": ["~/.ssh/known_hosts"],
            "fs_read":       ["/nix/store", "/run/current-system/sw"],
            // `nono profile validate` warns [allow_all_network] on this line.
            // Accepted: ssh cannot be routed through nono's HTTP proxy, and
            // allow_domain without an enforceable proxy is rejected outright.
            "network":       { "allow_all": true },
            "environment":   { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
          } }
        }
      },

      // Confined shell for the session: arbitrary tools may run inside this
      // sandbox, reaching $WORKDIR, the nix store, the system path, and
      // mise-installed toolchains (go, python, node, ...) — nothing else,
      // with no network. "session": "deny" is deliberately NOT set here,
      // unlike ssh above — the session is the intended caller, not one to be
      // blocked. NOT reachable from git (see the git entry's comment above)
      // — git cannot exec a hook at all, so a from.git edge here would be
      // dead weight.
      //
      // can_use: ["go"] plus the matching command_policies.commands.go.from.bash
      // edge below are what let `go version`/`go build`/`go test` run from
      // inside this sandbox at all — now that go is itself a declared
      // policy command (Tool Sandbox enforces the can_use chain even for a
      // command that used to be reachable from anywhere on exec_paths).
      // That edge is deliberately narrower than go's own from.session edge:
      // no "network" key, same as this sandbox's own denial above — chaining
      // through go from inside bash/sh must not become a side door around
      // bash/sh's own no-network rule.
      "bash": {
        "can_use": ["go"],
        "from": {
          "session": { "sandbox": {
            // /nix/store and /run/current-system/sw carry read AND exec
            // grants, not just exec: without the matching fs_read entry,
            // exec_paths alone does not let bash exec anything under a
            // directory (measured: with /nix/store dropped from fs_read but
            // left in exec_paths, `bash -c id` fails "Permission denied",
            // exit 126). ~/.local/share/mise is the same read+exec pairing,
            // needed because every toolchain this project uses (go, python,
            // node, ...) is installed there, not under /nix/store. Written
            // as "~" here: measured, "~" and "$HOME" both expand correctly
            // in fs_read/fs_write/exec_paths (unlike nono's
            // command_policies.executable_dirs field, which does not).
            "fs_read":     ["$WORKDIR", "/nix/store", "/run/current-system/sw",
                             "~/.local/share/mise"],
            "fs_write":    ["$WORKDIR"],
            "exec_paths":  ["/nix/store", "/run/current-system/sw",
                             "~/.local/share/mise"],
            "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
            // No "network" key at all. Its absence IS the denial — do not
            // "helpfully" fill it in with allow_domain/allow_all. Measured:
            // ~/.ssh/id_main and ~/.gitconfig are both denied from inside this
            // sandbox, and outbound network is refused. Do NOT add
            // ~/.config/mise here: tool binaries are in scope, mise's own
            // configuration is not.
          } }
        }
      },

      // Confined shell for the session only — same shape as bash above,
      // including the mise toolchain reach and the same from.go edge below
      // for the same reason (go is a declared policy command now; nothing
      // reaches it through a bare exec_paths grant anymore). NOT reachable
      // from git: git cannot exec a hook at all (see the git entry's
      // comment above), so there is no live caller edge for this to invoke
      // git through, and no git.from.sh edge accepting it as a caller
      // either.
      "sh": {
        "can_use": ["go"],
        "from": {
          "session": { "sandbox": {
            // Same read+exec pairing as bash above, and the same reason:
            // /nix/store and /run/current-system/sw need both fs_read and
            // exec_paths to actually exec anything under them, and
            // ~/.local/share/mise is where every mise-installed toolchain
            // (go, python, node, ...) lives, not under /nix/store. Written
            // as "~" here: measured, "~" and "$HOME" both expand correctly
            // in fs_read/fs_write/exec_paths (unlike nono's
            // command_policies.executable_dirs field, which does not).
            "fs_read":     ["$WORKDIR", "/nix/store", "/run/current-system/sw",
                             "~/.local/share/mise"],
            "fs_write":    ["$WORKDIR"],
            "exec_paths":  ["/nix/store", "/run/current-system/sw",
                             "~/.local/share/mise"],
            "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
            // No "network" key at all, same as bash above — absence is the
            // denial, not an oversight. Do NOT add ~/.config/mise, same
            // reasoning as bash above.
          } }
        }
      },

      // The Go toolchain's internal tools (compile, link, cover, ...) live off
      // PATH, under mise's install tree, and activating Tool Sandbox at all
      // (true the moment any command_policies.commands entry exists, which
      // git/ssh/bash/sh above already ensure) rebuilds the session's own
      // execute grant from PATH's trusted directories alone. Without a policy
      // here, `go build ./...` dies with "fork/exec
      // .../pkg/tool/linux_amd64/compile: permission denied" — measured, by
      // temporarily removing this entry and rerunning the same command.
      //
      // This replaces command_policies.executable_dirs, which used to grant
      // that same directory a different way and could not do this job:
      // executable_dirs does not expand "~" (only a literal, host-specific
      // path), and separately, nono refuses to treat a group/world-writable
      // directory as executable at all, so /tmp — where `go test` compiles a
      // binary and then execs it — could never have been added there. A
      // per-command policy has neither restriction.
      //
      // Network: this "network" key is granted, listing proxy.golang.org
      // and sum.golang.org — the only two hosts the Go toolchain itself
      // ever contacts. But that list is not what enforces anything: a
      // child's "network" key is an on/off switch for nono's own local
      // proxy, and the proxy filters against the SESSION's own top-level
      // network.allow_domain (14 hosts), not the two declared here — so
      // this edge's real reach, once turned on, is the same 14-host set
      // every other proxied edge in this profile reaches, not a narrower
      // one (measured the same way as git's edge above: an unrelated
      // domain substituted for the two below made no difference to
      // whether proxy.golang.org itself was reachable, because it is
      // already on the session's own list). Measured both ways with a
      // module not already in ~/go/pkg/mod: with no "network" key, `go mod
      // tidy` fails at DNS resolution ("dial udp ... socket: operation not
      // permitted"); with this "network" key plus the six proxy env vars
      // below, it succeeds, provided ~/go/pkg/sumdb is also writable
      // (sum.golang.org's client caches signed tree data there, a
      // directory `go mod`/`go get` write to even though it is not under
      // ~/go/pkg/mod) — without it the fetch gets as far as downloading
      // the module and then fails writing the sumdb cache. Chose to grant
      // it: every module this repository currently depends on is already
      // cached, so day-to-day `go build`/`go test` never exercise this,
      // but a future dependency bump would need it. The child "network"
      // key depends on the session's own top-level "network" block staying
      // present — against a proxy-less session it fails at init with "no
      // loopback proxy env was present" (measured).
      //
      // Caveat, stated plainly: a toolchain that compiles and immediately
      // runs code is bounded only by what its own sandbox reaches — not by
      // which other commands are declared. This one reaches $WORKDIR and
      // /tmp with both write and exec, because `go test` needs exactly that
      // to compile a binary and then run it, and it can write to
      // ~/go/pkg/sumdb (used above) — the one capability this edge adds
      // beyond the floor's own go_runtime/mise_manager groups, which do not
      // grant it; low risk on its own (a signed checksum-database cache,
      // and GOFLAGS/GONOSUM* are not in this edge's allow_vars), but real.
      // The filesystem reach here is narrower than the session-wide floor
      // access `go` had before this entry existed, even though the network
      // reach is not, and the filesystem boundary is still the honest one:
      // anything this sandbox can write into $WORKDIR or /tmp, it can also
      // execute.
      "go": {
        "from": {
          "session": { "sandbox": {
            "fs_read":     ["$WORKDIR", "/nix/store", "/run/current-system/sw",
                             "~/.local/share/mise", "~/go/pkg/mod",
                             "~/go/pkg/sumdb", "$XDG_CACHE_HOME/go-build"],
            "fs_write":    ["$WORKDIR", "/tmp", "~/go/pkg/mod",
                             "~/go/pkg/sumdb", "$XDG_CACHE_HOME/go-build"],
            "exec_paths":  ["~/.local/share/mise", "/tmp"],
            "network":     { "allow_domain": ["proxy.golang.org", "sum.golang.org"] },
            "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM",
                                             "MISE*", "__MISE*",
                                             "http_proxy", "HTTP_PROXY", "https_proxy",
                                             "HTTPS_PROXY", "no_proxy", "NO_PROXY"] }
          } },
          // bash and sh above declare can_use: ["go"] so `go version`/
          // `go build`/`go test` work from inside either shell. Deliberately
          // NOT the same sandbox as the session edge above: no "network" key
          // here, matching bash/sh's own no-network design — a script run
          // inside either shell must not gain module-proxy network access
          // that the shell itself does not have. Same filesystem/exec_paths
          // reach otherwise, so offline `go build`/`go test` behave the same
          // whether invoked directly or from inside bash/sh.
          "bash": { "sandbox": {
            "fs_read":     ["$WORKDIR", "/nix/store", "/run/current-system/sw",
                             "~/.local/share/mise", "~/go/pkg/mod",
                             "~/go/pkg/sumdb", "$XDG_CACHE_HOME/go-build"],
            "fs_write":    ["$WORKDIR", "/tmp", "~/go/pkg/mod",
                             "~/go/pkg/sumdb", "$XDG_CACHE_HOME/go-build"],
            "exec_paths":  ["~/.local/share/mise", "/tmp"],
            "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM",
                                             "MISE*", "__MISE*"] }
          } },
          "sh": { "sandbox": {
            "fs_read":     ["$WORKDIR", "/nix/store", "/run/current-system/sw",
                             "~/.local/share/mise", "~/go/pkg/mod",
                             "~/go/pkg/sumdb", "$XDG_CACHE_HOME/go-build"],
            "fs_write":    ["$WORKDIR", "/tmp", "~/go/pkg/mod",
                             "~/go/pkg/sumdb", "$XDG_CACHE_HOME/go-build"],
            "exec_paths":  ["~/.local/share/mise", "/tmp"],
            "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM",
                                             "MISE*", "__MISE*"] }
          } }
        }
      },

      // The docker daemon is root-equivalent: `docker run -v /:/host` mounts
      // the entire host filesystem into a container the caller then owns.
      // This entry's filesystem grants do not, and cannot, bound what the
      // daemon then does on the command's behalf — they bound only which
      // command may reach the daemon in the first place. Read everything
      // below with that distinction in mind: nothing here "sandboxes
      // docker" in the sense the other entries sandbox their own command.
      //
      // No unix-socket grant appears here, and none is needed for docker
      // itself: exec_paths alone is what lets docker reach
      // /var/run/docker.sock — measured, `docker ps` reaches the daemon
      // from this child sandbox with no filesystem.unix_socket entry
      // anywhere in this file. The FLOOR is unix-socket mediated and
      // refuses it: `curl -s --unix-socket /var/run/docker.sock
      // http://localhost/version`, run at the floor, is refused with "no
      // matching unix_socket capability", exit 7, both before and after
      // this entry existed. Measured.
      //
      // But Tool Sandbox's child sandboxes carry NO unix-socket mediation
      // AT ALL — this is not specific to docker's own entry, and this
      // entry does not create it. The identical curl command, run through
      // `bash -c` or `sh -c` (both already-declared commands, each able to
      // exec `curl` off their own /nix/store or /run/current-system/sw
      // exec_paths), reaches the daemon and gets a real response, with no
      // filesystem.unix_socket grant on either entry. This gap predates
      // this entry — it was introduced the moment bash/sh became declared
      // commands, not by adding docker here — so do NOT read this entry as
      // the thing gating daemon access: deleting or narrowing it would not
      // close that route, and did not open it either. What this entry
      // actually bounds is narrower and more honest: which command may run
      // under the *name* docker, with exec_paths that reach the daemon
      // directly by that name, without first going through bash/sh.
      // bash/sh being able to exec curl (or any other socket-speaking
      // binary) off their own exec_paths is part of that picture, and is a
      // deliberate grant, not a leak of this one. Measured.
      //
      // ~/.docker moved here from the floor's own filesystem.read (it used
      // to sit there next to `~/.orbstack`; neither path exists on this
      // host, so that floor grant conferred nothing and the
      // `bypass_protection` opt-in it required only printed a warning on
      // every run). It is one of nono's protected paths, but a child edge
      // can grant a protected path without the floor's `bypass_protection`
      // opt-in — child sandboxes have no way to express bypass_protection
      // at all, and none is needed here. Measured.
      //
      // The nix store path below carries docker's build hash and goes
      // stale the next time nixpkgs bumps the docker package; `agent-sandbox
      // doctor` checks it, same as git's exec_paths above. The two non-Nix
      // entries are portability, not redundancy: nono skips whichever
      // exec_paths entries do not exist on this host, and doctor only flags
      // an exec_paths set when EVERY entry in it is missing — so carrying
      // `/usr/libexec/docker` and `/usr/lib/docker` alongside the pinned nix
      // path costs nothing and keeps this working on a non-Nix host. Same
      // reasoning, and the same portability shape, as git's exec_paths list
      // above. The path is deliberately the `libexec/docker` directory, not
      // `bin/docker`: on NixOS, `bin/docker` is a small stub that re-execs
      // `libexec/docker/docker` by absolute path, and only the directory the
      // real binary lives under needs to be exec-reachable here.
      //
      // No argv-level policy either: this entry execs the real docker
      // binary directly, the same shape as git's own entry above. A
      // separate wrapper exists (`internal/safe/dockercompose`,
      // `cmd/safe_docker.go`) that checks `run`/`exec`/`compose` invocations
      // for `--privileged`, host-path or docker-socket bind mounts, and
      // similar — but it is not wired in here, so it buys back nothing for
      // this profile. Its two known gaps are unaffected by that either way,
      // for an operator who does wire it in later: `docker create` followed
      // by `docker start` reaches the same running state as `docker run`
      // with no dangerous flag present on either individual call, and
      // `--mount type=volume,volume-opt=device=...,volume-opt=o=bind` is a
      // bind mount in substance that the wrapper's check does not catch (it
      // keys on `type=bind` specifically, not this spec's `type=volume`).
      "docker": {
        "from": { "session": { "sandbox": {
          "fs_read":    ["$WORKDIR", "/nix/store", "/run/current-system/sw", "~/.docker"],
          "fs_write":   ["$WORKDIR"],
          "exec_paths": ["/nix/store/k9xql8h1fgvf6mdj4w8h2sfqwh6jr3w2-docker-29.6.2/libexec/docker",
                         "/usr/libexec/docker", "/usr/lib/docker"],
          "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
        } } }
      }
    }
  }
}

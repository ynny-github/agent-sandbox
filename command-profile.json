{
  // Written by hand, in nono's own schema: agent-sandbox does not generate,
  // read, or validate this file. What a brokered command may access is
  // decided by this file alone, together with nono's own base profiles.
  //
  // The section headings below group the grants the same way the deleted
  // capability catalog used to (go, python, node, rust, dart, flutter,
  // docker, ssh, mise, bashrc), so a grant can still be traced back to the
  // toolchain it serves. There is no longer a catalog.go this file tracks —
  // when a toolchain needs a new path, this file is where it gets added.

  "meta": { "name": "agent-sandbox commands (this repository)" },

  "groups": {
    "include": [
      // -- baseline (baselineGroups; granted whatever the capability list says)
      "nix_runtime",      // NixOS: /nix/store is where every executable lives

      // -- one group per runtime capability
      "go_runtime",       // capability: go
      "python_runtime",   // capability: python
      "node_runtime",     // capability: node
      "rust_runtime",     // capability: rust
      "mise_manager"      // capability: mise (read side; env vars below)
      // dart, flutter, docker, ssh and bashrc have no nono group — they spell
      // out their paths in filesystem below.
    ]
  },

  "filesystem": {
    "allow": [
      // -- not from the catalog: this profile's own session grants
      "$WORKDIR",
      "~/.local/state/agent-sandbox",
      "/tmp",                                  // go test compiles into, then execs from, /tmp

      // -- capability: go   (groups are read-only, so the caches are named here)
      "~/go/pkg/mod",
      "$XDG_CACHE_HOME/go-build",              // catalog perOSAllow.linux; darwin uses ~/Library/Caches/go-build

      // -- capability: python
      "$XDG_CACHE_HOME/uv",
      "~/.local/share/uv/python",              // uv's managed interpreters
      "$XDG_CACHE_HOME/pip",                   // catalog perOSAllow.linux; darwin uses ~/Library/Caches/pip

      // -- capability: node
      "~/.npm",
      "~/.local/share/pnpm",                   // catalog perOSAllow.darwin adds ~/Library/pnpm

      // -- capability: rust
      "~/.cargo/registry",
      "~/.cargo/git",
      // NOTE: rust_runtime grants all of ~/.cargo, publish token included, so
      // a brokered command can read it. There is no deny layer on this side
      // (or the agent's) that would hide it — this file is the only thing
      // that decides what a brokered command may read.

      // -- capability: dart
      "~/.pub-cache",
      "~/.dart",
      "~/.dart-tool",                          // dartdev writes analytics config here on startup
      // NOTE: ~/.dart-tool also holds pub-tokens.json (private repo
      // credentials), same as rust above — read access to it is decided by
      // this file alone.

      // -- capability: flutter
      "~/.config/flutter",
      "~/.local/share/mise/http-tarballs"
      // NOTE: this is a WRITE grant over every mise-installed binary, including
      // agent-sandbox itself. doctor's "broker binary is not writable" check will
      // fail while this line is present. Drop the flutter capability unless a
      // project actually needs it.
    ],

    "read": [
      // -- not from the catalog: NixOS execution precondition
      "/nix/store",
      "/run/current-system/sw",

      // -- capability: mise
      "~/.local/share/mise",
      "~/.config/mise",

      // -- capability: docker
      "~/.docker",
      "~/.orbstack"
    ],

    "read_file": [
      // -- capability: bashrc
      "~/.bashrc",
      "/etc/bashrc",
      "/etc/bash.bashrc"
      // NOTE: the broker never dispatches a shell, so nothing here reads these.
      // Carried only because the capability defines them.
    ],

    "allow_file": [
      // -- baseline (baselineAllowFile)
      "/dev/null"
    ],

    "bypass_protection": [
      // catalog `bypass`: these prefixes are protected by nono, and a grant
      // against one is refused without this opt-in.
      "~/.docker",                             // capability: docker
      "~/.bashrc"                              // capability: bashrc
    ]
  },

  "environment": {
    "allow_vars": [
      // -- baseline (baselineEnv)
      "PATH", "HOME", "TERM", "LANG", "LC_ALL", "USER",

      // -- capability: mise
      "MISE*", "__MISE*",

      // -- capability: dart
      "PUB_CACHE", "PUB_HOSTED_URL",

      // -- capability: flutter
      "FLUTTER_ROOT", "FLUTTER_STORAGE_BASE_URL",

      // -- not from the catalog: proxy variables this profile carries itself
      "http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY", "no_proxy", "NO_PROXY"

      // DO NOT add AGENT_SANDBOX_BROKER_SOCKET, and do not add a wildcard that
      // would match it. It is agentOnlyEnv: a command that can reach the broker
      // socket can recurse into broker.Server.Serve, which spawns handlers with
      // no concurrency cap — a host-side fork bomb. ResolveShell used to be the
      // code that kept it out of this profile; that code is gone, so this list
      // being explicit is the only thing left enforcing it.
    ]
  },

  "network": {
    "allow_domain": [
      // -- common to every toolchain: source and release artefacts
      "github.com",
      "*.githubusercontent.com",        // raw. and objects. (release assets, uv's CPython builds)
      "codeload.github.com",            // tarball/zipball downloads: go get direct, pip/uv "git+" archives, mise

      // -- capability: go
      "proxy.golang.org",
      "sum.golang.org",

      // -- capability: python
      "pypi.org",
      "files.pythonhosted.org",

      // -- capability: node
      "registry.npmjs.org",

      // -- capability: rust
      "index.crates.io",                // the sparse index cargo resolves against
      "static.crates.io",               // the .crate files themselves

      // -- capability: dart
      "pub.dev",

      // -- capability: flutter
      "storage.googleapis.com",         // SDK and engine artefacts
      // "storage.flutter-io.cn" is the China mirror; add only if FLUTTER_STORAGE_BASE_URL points there.

      // -- capability: mise
      "mise.jdx.dev",                   // version/registry metadata
      "api.github.com"                  // release listings mise resolves tools through
    ]
  },

  "command_policies": {
    // Not about git. Activating Tool Sandbox at all rebuilds the outer session's
    // execute grant from the trusted directories on PATH, and go's internal
    // toolchain does not live on PATH: without this line `go build ./...` dies
    // with "fork/exec .../pkg/tool/linux_amd64/compile: permission denied".
    // Neither ~ nor $HOME is expanded here, so the path is literal. "1.25" is
    // mise's minor-version symlink and .mise.toml pins go = "1.25", so a patch
    // upgrade does not break it; a minor bump does, loudly.
    // /tmp cannot be added: nono refuses a group/world-writable executable dir.
    "executable_dirs": ["/home/yn/.local/share/mise/installs/go/1.25/pkg/tool/linux_amd64"],

    "commands": {
      // DO NOT shorten "from": {"session": …} to the "sandbox" shorthand. nono
      // runs both identically, but `nono why --profile <this> --command git`
      // does not implement the shorthand: it answers DENIED / missing
      // from.session for a command that demonstrably runs. `ai explain` tells
      // the agent to run exactly that query, so the false denial would reach
      // the agent unmediated. Measured on nono 0.74.0.
      //
      // DO NOT pin "executable" here either. A pin whose path does not exist
      // silently disables mediation for the command: nono falls back to the
      // first PATH match and runs it at the SESSION's grants, `nono profile
      // validate` still passes, and the audit records "tools: active, no
      // invocations". git's path is a /nix/store path that changes on every
      // nixpkgs update, so a pin here would un-sandbox git on the next upgrade.
      // Measured on nono 0.74.0. `agent-sandbox doctor` checks the paths below
      // still exist for the same reason.
      //
      // Git hooks do NOT execute from this sandbox. `git commit` fails with
      // "fatal: cannot exec '.git/hooks/commit-msg': Permission denied";
      // use `git commit --no-verify`.
      //
      // Making them execute is POSSIBLE — it needs $WORKDIR and /nix/store
      // added to this exec_paths below, because a hook's shebang makes the
      // KERNEL exec the interpreter (/bin/sh, under /nix/store) as part of
      // git's own execve() of the hook file, before nono's command-name
      // matching for "sh" can apply to the new process. This was measured
      // and built (nono 0.74.0), then DELIBERATELY REVERTED: $WORKDIR is
      // agent-writable, and this sandbox already carries network
      // (allow_domain below) and read access to the global gitconfig — so
      // that widening lets git execute arbitrary agent-written content, with
      // network, the moment it lands in the working tree. That is a
      // write-then-execute path, and it sits outside the confinement the
      // user set for arbitrary-tool execution (workdir data, no network —
      // see the sh/bash entries below, which honor that bar; git's own
      // sandbox does not).
      //
      // It would also buy nothing: this repo's hooks invoke lefthook by a
      // version-stamped absolute path
      // (.../mise/installs/lefthook/2.1.10/lefthook_2.1.10_Linux_x86_64),
      // whose basename matches no policy command name, so nothing mediates
      // it even if the hook script itself could run — it prints "Can't find
      // lefthook in PATH", exits 0, and the commit is accepted unvalidated
      // either way. Pinning a command named after that version-stamped
      // binary would "fix" the name-matching half and is separately not
      // done: the version stamp changes on every lefthook upgrade, so the
      // pin would silently stop matching, the same failure mode the "DO NOT
      // pin executable" note above warns about for git itself.
      //
      // Net effect, with or without hooks executing: commit-message
      // validation does NOT run inside this sandbox. Do not re-open the
      // hook-execution path to try to fix that — it was tried, it does not
      // fix it, and it costs arbitrary execution with network. Measured on
      // nono 0.74.0.
      "git": {
        "can_use": ["ssh"],
        "from": {
          "session": { "sandbox": {
            // Global/system git config plus the declared target of every
            // include.path / includeIf.*.path in those scopes. local and worktree
            // scopes are deliberately excluded by nono, so a repository cannot
            // grant itself host access through its own .git/config.
            "fs_read_file": ["@git:config-files"],
            "fs_read":      ["@git:hooks-path", "$WORKDIR", "/nix/store", "/run/current-system/sw"],
            // @git:common-dir covers the object store when $WORKDIR is a linked
            // worktree; @git:worktree covers the main repo root, without which
            // `git worktree add` fails at getcwd() with EPERM.
            "fs_write":     ["$WORKDIR", "@git:common-dir", "@git:worktree", "@git:toplevel"],
            // Needed ONLY for HTTPS transport: git-remote-https is a separate
            // binary under libexec/git-core. Without this, local operations and
            // SSH remotes still work and HTTPS fails with
            // "fatal: cannot exec 'remote-https': Permission denied".
            // nono SKIPS exec_paths entries that do not exist, so a nixpkgs git
            // update breaks HTTPS here silently. doctor checks for that.
            "exec_paths":   ["/nix/store/8yh8zbb0r4na7gkqk0db0gbdid2ax7zm-git-2.54.0/libexec/git-core"],
            // Governs HTTPS remotes only; SSH remotes go out through the ssh
            // entry below. Requires the session's own top-level network block to
            // be present — a child allow_domain against a proxy-less session
            // fails at init with "no loopback proxy env was present".
            "network":      { "allow_domain": ["github.com", "*.githubusercontent.com"] },
            "environment":  { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM",
                                             "http_proxy", "HTTP_PROXY", "https_proxy",
                                             "HTTPS_PROXY", "no_proxy", "NO_PROXY"] }
          } }
        }
      },

      // The only reason ~/.ssh can come off the floor. Reachable from git and
      // from nothing else: direct session ssh is refused with exit 126.
      "ssh": {
        "from": {
          "session": "deny",
          "git": { "sandbox": {
            // The official git-ssh example brokers $SSH_AUTH_SOCK as a
            // local-socket credential and prefers that to a raw key grant. Not
            // usable here: SSH_AUTH_SOCK is set on this host but points at a
            // socket that no longer exists, and a profile declaring the
            // credential fails before launch. If a live agent ever becomes
            // standard, replace the id_main grant with:
            //   "credentials": { "ssh-agent": { "type": "local-socket",
            //     "path": "$SSH_AUTH_SOCK", "mode": "connect",
            //     "env_var": "SSH_AUTH_SOCK" } }
            // at command_policies level, and "use_credentials": ["ssh-agent"] here.
            "fs_read_file":  ["~/.ssh/id_main", "~/.ssh/config", "~/.ssh/known_hosts"],
            "fs_write_file": ["~/.ssh/known_hosts"],
            "fs_read":       ["/nix/store", "/run/current-system/sw"],
            // `nono profile validate` warns [allow_all_network] on this line.
            // Accepted: ssh cannot be routed through nono's HTTP proxy, and
            // allow_domain without an enforceable proxy is rejected outright.
            "network":       { "allow_all": true },
            "environment":   { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
          } }
        }
      },

      // Confined shell for the session: arbitrary tools may run inside this
      // sandbox, but only against $WORKDIR and with no network. "session":
      // "deny" is deliberately NOT set here, unlike ssh above — the session
      // is the intended caller, not one to be blocked. NOT reachable from
      // git (see the git entry's comment above) — git cannot exec a hook at
      // all, so a from.git edge here would be dead weight.
      "bash": {
        "from": {
          "session": { "sandbox": {
            // /nix/store and /run/current-system/sw are read grants, not just
            // exec grants: nono requires a matching fs_read for anything named
            // in exec_paths, so without these bash cannot exec a single
            // external program (measured: fs_read limited to $WORKDIR alone
            // leaves bash unable to exec anything on PATH). This is what makes
            // "arbitrary tools inside the confinement" possible while data
            // access stays limited to fs_read/fs_write below.
            "fs_read":     ["$WORKDIR", "/nix/store", "/run/current-system/sw"],
            "fs_write":    ["$WORKDIR"],
            "exec_paths":  ["/nix/store", "/run/current-system/sw"],
            "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
            // No "network" key at all. Its absence IS the denial — do not
            // "helpfully" fill it in with allow_domain/allow_all. Measured:
            // ~/.ssh/id_main and ~/.gitconfig are both denied from inside this
            // sandbox, and outbound network is refused.
          } }
        }
      },

      // Confined shell for the session only — same shape as bash above.
      // NOT reachable from git, and carries no can_use of its own: git
      // cannot exec a hook at all (see the git entry's comment above), so
      // there is no live caller edge for this to invoke git through, and no
      // git.from.sh edge accepting it as a caller either. $WORKDIR only, no
      // network.
      "sh": {
        "from": {
          "session": { "sandbox": {
            "fs_read":     ["$WORKDIR", "/nix/store", "/run/current-system/sw"],
            "fs_write":    ["$WORKDIR"],
            "exec_paths":  ["/nix/store", "/run/current-system/sw"],
            "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
            // No "network" key at all, same as bash above — absence is the
            // denial, not an oversight.
          } }
        }
      }
    }
  }
}

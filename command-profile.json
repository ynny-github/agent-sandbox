{
  // Written by hand, in nono's own schema: agent-sandbox does not generate,
  // read, or validate this file. What a command run through execd may access
  // is decided by this file alone, together with nono's own base profiles.
  //
  // The section headings below group the grants the same way the deleted
  // capability catalog used to (go, python, node, rust, dart, flutter,
  // docker, ssh, mise, bashrc), so a grant can still be traced back to the
  // toolchain it serves. There is no longer a catalog.go this file tracks —
  // when a toolchain needs a new path, this file is where it gets added.

  "meta": { "name": "agent-sandbox commands (this repository)" },

  "groups": {
    "include": [
      // -- baseline (baselineGroups; granted whatever the capability list says)
      "nix_runtime",      // NixOS: /nix/store is where every executable lives

      // -- one group per runtime capability
      "go_runtime",       // capability: go
      "python_runtime",   // capability: python
      "node_runtime",     // capability: node
      "mise_manager"      // capability: mise (read side; env vars below)
      // rust_runtime is deliberately NOT included. It grants read over all of
      // ~/.cargo (`nono profile groups rust_runtime`), publish token included,
      // and the floor is what every undeclared command now runs at — so that
      // group put a secret exactly where the scope rule in command_policies
      // below says no secret may be. Measured before removing it: a floor
      // `cat ~/.cargo/credentials.toml` printed the token; after, it is
      // refused. The two ~/.cargo lines under filesystem.allow below keep
      // cargo's caches reachable without it. (Measured either side of the
      // change: `cargo --version` fails identically on this host both ways —
      // this repository does not use rust, so nothing regressed.) Add
      // ~/.rustup, or a further ~/.cargo subdirectory, by name if a rust
      // project ever needs one; do not re-include the group.
      //
      // dart, flutter and bashrc have no nono group — they spell out their
      // paths in filesystem below. docker and ssh have no nono group
      // either, but neither spells its paths out in filesystem any more:
      // both are declared commands now, and spell their paths out under
      // command_policies.commands instead.
    ]
  },

  "filesystem": {
    "allow": [
      // -- not from the catalog: this profile's own session grants
      "$WORKDIR",
      "~/.local/state/agent-sandbox",
      "/tmp",                                  // scratch space floor commands may need (uv, npm, pip, mise, ...) —
                                                // NOT why go test works: go is a policy command below now, with its
                                                // own separate /tmp grant, and compiles into/execs from that one

      // -- capability: go   (groups are read-only, so the caches are named here)
      "~/go/pkg/mod",
      "~/go/pkg/sumdb",                        // NOT from the catalog: carried down from the deleted "go" command
                                               // entry, which granted it. sum.golang.org's client caches signed
                                               // tree data here, outside ~/go/pkg/mod, and a module fetch without
                                               // it downloads the module and then fails writing this cache.
                                               // Nothing in this repository's current dependency set exercises it
                                               // — every module is already cached — but a dependency bump would.
      "$XDG_CACHE_HOME/go-build",              // catalog perOSAllow.linux; darwin uses ~/Library/Caches/go-build

      // -- capability: python
      "$XDG_CACHE_HOME/uv",
      "~/.local/share/uv/python",              // uv's managed interpreters
      "$XDG_CACHE_HOME/pip",                   // catalog perOSAllow.linux; darwin uses ~/Library/Caches/pip

      // -- capability: node
      "~/.npm",
      "~/.local/share/pnpm",                   // catalog perOSAllow.darwin adds ~/Library/pnpm

      // -- capability: rust
      "~/.cargo/registry",
      "~/.cargo/git",
      // NOTE: these two lines are the whole of ~/.cargo that is reachable now.
      // rust_runtime, which used to grant all of it, is deliberately out of
      // groups.include above — see the note there. There is no deny layer on
      // this side (or the agent's) that would hide anything: this file is the
      // only thing that decides what a command run through execd may read,
      // which is why a grant's width is the whole of its security argument.

      // -- capability: dart
      "~/.pub-cache",
      "~/.dart",
      "~/.dart-tool",                          // dartdev writes analytics config here on startup
      // NOTE: ~/.dart-tool also holds pub-tokens.json (private repo
      // credentials), same as rust above — read access to it is decided by
      // this file alone.

      // -- capability: flutter
      "~/.config/flutter"
      // NOTE: "~/.local/share/mise/http-tarballs" used to sit here as the
      // flutter capability's second line. Removed: it is a WRITE grant over
      // the archives mise later unpacks into toolchains, which makes it a
      // poisoning route into a future `mise install`, and the floor is now
      // where every undeclared command runs — measured, a floor shell could
      // write there. What this note used to claim, that the grant reaches
      // "every mise-installed binary, including agent-sandbox itself", is
      // wrong and was never measured: agent-sandbox lives under
      // ~/.local/share/mise/installs/go/<ver>/bin, which that line did not
      // cover, and a floor write into installs/ was refused both before and
      // after. Restore the line only if a project actually builds flutter,
      // and say so here when you do.
    ],

    "read": [
      // -- not from the catalog: NixOS execution precondition
      "/nix/store",
      "/run/current-system/sw",

      // -- capability: mise
      "~/.local/share/mise",
      "~/.config/mise"
    ],

    "read_file": [
      // -- capability: bashrc
      "~/.bashrc",
      "/etc/bashrc",
      "/etc/bash.bashrc"
      // NOTE: these are live again. While bash and sh were declared commands,
      // a floor read_file grant did not propagate into their child sandboxes
      // and so nothing read them; now that both run at the floor, a shell
      // started through execd reads them like any other floor file.
    ],

    "allow_file": [
      // -- baseline (baselineAllowFile)
      "/dev/null"
    ],

    "bypass_protection": [
      // catalog `bypass`: these prefixes are protected by nono, and a grant
      // against one is refused without this opt-in.
      "~/.bashrc"                              // capability: bashrc
    ],

    // Carried alongside "linux": { "af_unix_mediation": "pathname" } below,
    // but this grant's own reason for existing is independent of that key,
    // not gated by it. On nono 0.74.0, an execd started WITHOUT the
    // launcher's own "--allow-unix-socket-bind" flag has its bind refused
    // unless this grant is present — measured true with af_unix_mediation
    // present, and equally true with it absent entirely. It is NOT
    // load-bearing for the one production launch path this repository
    // actually uses: ExecdArgs (agent-sandbox/internal/claude/launch.go,
    // around line 511) always passes "--allow-unix-socket-bind" itself, and
    // through that flag the bind already succeeds with this entry absent —
    // measured, round trip clean either way. This entry exists so the
    // profile stands on its own for an execd started some other way — by
    // hand, or by something other than `agent-sandbox claude` — where no
    // launcher flag is there to cover it. Not redundant with the plain
    // "~/.local/state/agent-sandbox" entry under "allow" above: that one is
    // a read/write path grant and says nothing about bind.
    "unix_socket_dir_bind": ["~/.local/state/agent-sandbox"]
  },

  "environment": {
    "allow_vars": [
      // -- baseline (baselineEnv)
      "PATH", "HOME", "TERM", "LANG", "LC_ALL", "USER",

      // -- capability: mise
      "MISE*", "__MISE*",

      // -- capability: dart
      "PUB_CACHE", "PUB_HOSTED_URL",

      // -- capability: flutter
      "FLUTTER_ROOT", "FLUTTER_STORAGE_BASE_URL",

      // -- not from the catalog: proxy variables this profile carries itself
      "http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY", "no_proxy", "NO_PROXY"

      // DO NOT add AGENT_SANDBOX_EXECD_SOCKET, and do not add a wildcard that
      // would match it. It is agentOnlyEnv: a command that can reach the execd
      // socket can recurse into execd.Server.Serve, which spawns handlers with
      // no concurrency cap — a host-side fork bomb. ResolveShell used to be the
      // code that kept it out of this profile; that code is gone, so this list
      // being explicit is the only thing left enforcing it.
    ]
  },

  "network": {
    "allow_domain": [
      // -- common to every toolchain: source and release artefacts
      "github.com",
      "*.githubusercontent.com",        // raw. and objects. (release assets, uv's CPython builds)
      "codeload.github.com",            // tarball/zipball downloads: go get direct, pip/uv "git+" archives, mise

      // -- capability: go
      "proxy.golang.org",
      "sum.golang.org",

      // -- capability: python
      "pypi.org",
      "files.pythonhosted.org",

      // -- capability: node
      "registry.npmjs.org",

      // -- capability: rust
      "index.crates.io",                // the sparse index cargo resolves against
      "static.crates.io",               // the .crate files themselves

      // -- capability: dart
      "pub.dev",

      // -- capability: flutter
      "storage.googleapis.com",         // SDK and engine artefacts
      // "storage.flutter-io.cn" is the China mirror; add only if FLUTTER_STORAGE_BASE_URL points there.

      // -- capability: mise
      "mise.jdx.dev",                   // version/registry metadata
      "api.github.com"                  // release listings mise resolves tools through
    ]
  },

  // The hole this WAS carried for, and why it is no longer open: Tool
  // Sandbox's child sandboxes carry NO AF_UNIX mediation at all on this
  // host's nono, so any declared command whose sandbox can run arbitrary
  // code reaches host unix sockets the floor refuses — /var/run/docker.sock
  // among them, which is root-equivalent. Measured on nono 0.74.0, while
  // bash, sh and go were still declared: the FLOOR refuses
  // `curl -s --unix-socket /var/run/docker.sock http://localhost/version`
  // ("no matching unix_socket capability", exit 7), but the identical curl
  // through `bash -c` or `sh -c` got the daemon's version JSON, and so did
  // a raw AF_UNIX connect from a Go program under `go run` — no docker
  // binary involved anywhere, and `bash -c 'docker ps'` refused by can_use
  // the whole time, which was always a much narrower guarantee than "the
  // socket is gated". Dropping those three entries (see the scope rule in
  // command_policies below) is what closed it: with no arbitrary-code
  // command declared, both routes are refused, 3/3 each.
  //
  // That closure does NOT come from the key below, and the key is still
  // inert here. Measured, 3/3 each side: with this whole "linux" object
  // deleted, the floor refuses that same curl exactly as it does with the
  // object present. What refuses it is the floor granting no unix_socket
  // capability at all, not this switch.
  //
  // "af_unix_mediation": "pathname" is nono's session-level switch for
  // AF_UNIX mediation, default Off. It is session-wide by construction, not
  // per-command: a command policy's own child sandbox ("sandbox" object
  // under command_policies.commands below) has no connect-side field of
  // its own to express this — nono's CommandSandboxConfig carries only
  // unix_socket_bind (a bind grant, not a connect gate), and only since
  // nono 0.76.0 (PR #1780). On 0.74.0 the child schema does not have that
  // field at all, so there is no per-command way to ask for connect-side
  // mediation even if this switch is flipped on. nono 0.77.0 builds on this
  // host but cannot start Tool Sandbox at all on NixOS ("failed to resolve
  // ELF dependency 'libgcc_s.so.1' for .../shims/bash"); tmp/nono-nixos-elf-
  // fix.patch applies cleanly to 0.77.0 and is correctly wired in, and even
  // so no longer fixes that failure. And 0.77.0's own child schema still
  // only has unix_socket_bind — no connect side — so a per-child connect
  // rule remains inexpressible there too.
  //
  // The key is therefore carried, not relied on: it states the mechanism,
  // and it is the thing that would start mattering the moment anyone
  // declares an arbitrary-code command here again. Do not read its presence
  // as the reason the socket is closed today — the short commands list is.
  "linux": { "af_unix_mediation": "pathname" },

  "command_policies": {
    // SCOPE RULE for this block, and the reason it is this short: a command is
    // declared below ONLY when it handles a secret. git (the global gitconfig
    // and, through the ssh chain, the signing/push key), ssh (~/.ssh/id_main)
    // and docker (a root-equivalent daemon socket) are the whole list. Every
    // other command — the shells, the toolchains, everything an agent actually
    // types — is NOT declared, and therefore runs at this profile's own floor.
    //
    // That is the boundary, and it holds because the floor holds: a command
    // that is not declared gets the session's grants and nothing more, and the
    // secrets are not on the floor (`nono run --profile ./command-profile.json
    // -- cat ~/.ssh/id_main` and the same for ~/.gitconfig are both refused,
    // measured). Do NOT reason the other way round: a DECLARED command's edge
    // is not clamped by the floor and can grant a path the floor refuses —
    // that asymmetry is exactly how ~/.ssh comes off the floor and stays
    // reachable by ssh alone.
    //
    // bash, sh and go used to be declared here, as confinement entries rather
    // than secret-handling ones. Removing them is what closed this profile's
    // largest hole. Tool Sandbox child sandboxes carry NO AF_UNIX mediation on
    // nono 0.74.0, so any declared command that can run arbitrary code reaches
    // host unix sockets the floor refuses — including /var/run/docker.sock,
    // which is root-equivalent. Measured, 3/3 each: with bash declared,
    // `bash -c 'curl -s --unix-socket /var/run/docker.sock ...'` got the
    // daemon's version JSON; with bash and sh removed but go still declared,
    // `go run` on a program calling net.Dial("unix", "/var/run/docker.sock")
    // still connected; with go removed too, both are refused (curl exit 7,
    // Dial denied), because the floor grants no unix_socket capability and
    // there is no longer a child sandbox that escapes the floor. NOT because
    // of "linux": { "af_unix_mediation": "pathname" } above — that key is
    // still inert here, measured both ways (see its own comment). The hole
    // was never about which command was named: it was about any
    // arbitrary-code child sandbox existing at all.
    //
    // What that traded away, stated plainly (this is the half that gets
    // omitted): a shell at the floor now reaches the session's 14-host
    // network.allow_domain list, where the old bash/sh entries had no network
    // key at all; and because an undeclared caller resolves as the SESSION,
    // a shell can now invoke git and docker, which the old can_use chain
    // refused (`bash -c 'git status'` used to exit 126). docker being freely
    // reachable from the session is a deliberate, separate decision — see its
    // entry below — not something this change introduced.
    //
    // The Go toolchain's internal tools (compile, link, vet, ...) live off
    // PATH under mise's install tree, and the non-empty "commands" object
    // below activates Tool Sandbox, which rebuilds the SESSION's own execute
    // grant from PATH's trusted directories alone. So dropping the "go" entry
    // breaks the toolchain unless that grant is restored here: measured, with
    // go undeclared and this field absent, `go build ./...` fails and `go vet`
    // dies with "fork/exec .../pkg/tool/linux_amd64/vet: permission denied".
    // With the two entries below, `go build`, `go vet` and `go run` all pass
    // through execd — `go run` on a cold AND a warm build cache, which the
    // old "go" entry did not manage (its exec_paths reached /tmp but not
    // $XDG_CACHE_HOME/go-build, so a second `go run` of the same program died
    // at "fork/exec ~/.cache/go-build/.../main: permission denied"). The Go
    // test suite is green outside the sandbox before and after this change;
    // `go test ./...` run THROUGH execd fails either way and always has —
    // those tests spawn processes and bind sockets — so it is not a signal
    // to read here.
    //
    // Three measured properties of this field, none of them obvious:
    //   - It does NOT expand "~" or "$HOME". A "$HOME/..." entry is refused at
    //     startup with "command_policies.executable_dirs entry '$HOME/...' is
    //     not readable". Literal absolute paths only, so this field is the one
    //     host-specific thing in this file.
    //   - It is NOT recursive. Pointing it at ~/.local/share/mise changes
    //     nothing; the directory holding the binaries must be named exactly.
    //   - A missing entry REFUSES TO START the session. That is the opposite
    //     of exec_paths (silently skipped) and of a stale "executable" pin
    //     (silently un-mediates the command) — here the failure is loud, which
    //     is why pinning a path is acceptable at all.
    // The version component is mise's own minor symlink
    // (installs/go/1.25 -> ./1.25.14), so patch bumps pass straight through;
    // it pairs with go = "1.25" in .mise.toml, and raising that minor means
    // editing both. `agent-sandbox doctor` checks these paths still exist for
    // the same reason it checks git's and docker's exec_paths.
    "executable_dirs": [
      "/home/yn/.local/share/mise/installs/go/1.25/pkg/tool/linux_amd64",
      "/home/yn/.local/share/mise/installs/go/1.25/bin"
    ],

    "commands": {
      // DO NOT shorten "from": {"session": …} to the "sandbox" shorthand. nono
      // runs both identically, but `nono why --profile <this> --command git`
      // does not implement the shorthand: it answers DENIED / missing
      // from.session for a command that demonstrably runs. `ai explain` tells
      // the agent to run exactly that query, so the false denial would reach
      // the agent unmediated. Measured on nono 0.74.0.
      //
      // DO NOT pin "executable" here either. A pin whose path does not exist
      // disables mediation for the command entirely: nono falls back to the
      // first PATH match and runs it at the SESSION's grants, `nono profile
      // validate` still passes, and the audit records "tools: active, no
      // invocations". This is not silent — nono prints "[nono] Warning: 1
      // command policy not found on PATH, skipping: <name>", and --silent
      // does not suppress it — but the warning is easy to miss in a wall of
      // launch output, and the danger it names is real. git's path is a
      // /nix/store path that changes on every nixpkgs update, so a pin here
      // would un-sandbox git on the next upgrade. Measured on nono 0.74.0.
      // `agent-sandbox doctor` checks the paths below still exist for the
      // same reason.
      //
      // Git hooks do NOT execute from this sandbox. `git commit` fails with
      // "fatal: cannot exec '.git/hooks/commit-msg': Permission denied";
      // use `git commit --no-verify`.
      //
      // Making them execute would need $WORKDIR and /nix/store added to this
      // exec_paths below (a hook's shebang makes the kernel exec the
      // interpreter, under /nix/store, as part of git's own execve() of the
      // hook file). This is deliberately NOT done — on the benefit argument
      // alone, which is decisive by itself: enabling hooks buys back
      // nothing. Measured, with hooks temporarily enabled for the test:
      // lefthook still did not run, and a commit message that violates this
      // repo's Conventional Commits rule was accepted unvalidated here,
      // while the identical message was rejected outside nono. The reason
      // lefthook did not run was not isolated (this repo's hook tries a
      // plain `lefthook` on PATH before falling back to a version-stamped
      // absolute path; either could be the one failing) — do not assume a
      // mechanism and do not "fix" one without re-measuring first. Net
      // effect, with or without hooks executing: commit-message validation
      // does NOT run inside this sandbox. Do not re-open the hook-execution
      // path to try to fix that — it was tried, it does not fix it.
      // Measured on nono 0.74.0.
      //
      // The security argument does not carry this on its own: the floor
      // already has a write-then-execute path of its own — a Go binary
      // built into $WORKDIR runs at the floor. Its network reach is the
      // SAME as this sandbox's, not larger: a child's "network" key is an
      // on/off switch for nono's own local proxy, and the proxy filters
      // against the SESSION's top-level network.allow_domain, not the
      // child's own declared list — measured, this sandbox's declared
      // ["github.com", "*.githubusercontent.com"] notwithstanding, from
      // inside it: `git ls-remote https://pypi.org/...` reaches pypi.org
      // (session-listed, not here) and gets pypi's own 404, while
      // `https://example.com/...` is refused by the proxy outright (listed
      // in neither). So widening exec_paths here to $WORKDIR + /nix/store
      // would add no new class of capability, network included. Measured.
      // The one genuine delta it would
      // cost: arbitrary code running in git's child sandbox would gain read
      // access to the global gitconfig, which the floor does NOT have
      // (`path_not_granted` at the floor; measured). Also measured, with
      // exec_paths temporarily widened in a throwaway build of this profile
      // (NOT the shipped state above — that widening was reverted; see
      // commits 258b9a9 and 45eb9fa): a hand-written
      // `.git/hooks/pre-commit` ran and printed its own output inside git's
      // sandbox.
      "git": {
        "can_use": ["ssh"],
        "from": {
          "session": { "sandbox": {
            // Global/system git config plus the declared target of every
            // include.path / includeIf.*.path in those scopes. local and worktree
            // scopes are deliberately excluded by nono, so a repository cannot
            // grant itself host access through its own .git/config.
            "fs_read_file": ["@git:config-files"],
            "fs_read":      ["@git:hooks-path", "$WORKDIR", "/nix/store", "/run/current-system/sw"],
            // @git:common-dir covers the object store when $WORKDIR is a linked
            // worktree; @git:worktree covers the main repo root, without which
            // `git worktree add` fails at getcwd() with EPERM.
            "fs_write":     ["$WORKDIR", "@git:common-dir", "@git:worktree", "@git:toplevel"],
            // Needed ONLY for HTTPS transport: git-remote-https is a separate
            // binary under libexec/git-core. Without this, local operations and
            // SSH remotes still work and HTTPS fails with
            // "fatal: cannot exec 'remote-https': Permission denied".
            // nono SKIPS exec_paths entries that do not exist, so a nixpkgs git
            // update breaks HTTPS here silently. doctor checks for that.
            // /usr/lib/git-core and /usr/libexec/git-core are also listed,
            // unconditionally: a missing entry costs nothing (skipped, same
            // as a stale nix hash would be), and having them means HTTPS
            // transport also works on a non-Nix host — this file is not
            // NixOS-only.
            "exec_paths":   ["/nix/store/8yh8zbb0r4na7gkqk0db0gbdid2ax7zm-git-2.54.0/libexec/git-core",
                              "/usr/lib/git-core", "/usr/libexec/git-core"],
            // Governs HTTPS remotes only; SSH remotes go out through the ssh
            // entry below. This "network" key is an on/off switch for
            // nono's own local proxy, not a narrower allowlist: the proxy
            // filters against the SESSION's own top-level
            // network.allow_domain (14 hosts), not the list declared here.
            // Measured: from inside this sandbox, `git ls-remote` reaches
            // pypi.org (session-listed, not in the two domains below) and
            // is refused example.com (in neither list). What actually
            // gates HTTPS here is (a) this key being present at all, and
            // (b) the six proxy env vars just below being forwarded, so
            // the child can find nono's local proxy — which in turn
            // requires the session's own top-level network block to stay
            // present: a child "network" key against a proxy-less session
            // fails at init with "no loopback proxy env was present".
            "network":      { "allow_domain": ["github.com", "*.githubusercontent.com"] },
            "environment":  { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM",
                                             "http_proxy", "HTTP_PROXY", "https_proxy",
                                             "HTTPS_PROXY", "no_proxy", "NO_PROXY"] }
          } }
        }
      },

      // The only reason ~/.ssh can come off the floor. Reachable from git and
      // from nothing else: direct session ssh is refused with exit 126.
      "ssh": {
        "from": {
          "session": "deny",
          "git": { "sandbox": {
            // The official git-ssh example forwards $SSH_AUTH_SOCK as a
            // local-socket credential and prefers that to a raw key grant. Not
            // usable here: SSH_AUTH_SOCK is set on this host but points at a
            // socket that no longer exists, and a profile declaring the
            // credential fails before launch. If a live agent ever becomes
            // standard, replace the id_main grant with:
            //   "credentials": { "ssh-agent": { "type": "local-socket",
            //     "path": "$SSH_AUTH_SOCK", "mode": "connect",
            //     "env_var": "SSH_AUTH_SOCK" } }
            // at command_policies level, and "use_credentials": ["ssh-agent"] here.
            "fs_read_file":  ["~/.ssh/id_main", "~/.ssh/config", "~/.ssh/known_hosts"],
            "fs_write_file": ["~/.ssh/known_hosts"],
            "fs_read":       ["/nix/store", "/run/current-system/sw"],
            // `nono profile validate` warns [allow_all_network] on this line.
            // Accepted: ssh cannot be routed through nono's HTTP proxy, and
            // allow_domain without an enforceable proxy is rejected outright.
            "network":       { "allow_all": true },
            "environment":   { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
          } }
        }
      },

      // The docker daemon is root-equivalent: `docker run -v /:/host` mounts
      // the entire host filesystem into a container the caller then owns.
      // This entry's filesystem grants do not, and cannot, bound what the
      // daemon then does on the command's behalf — they bound only which
      // command may reach the daemon in the first place. Read everything
      // below with that distinction in mind: nothing here "sandboxes
      // docker" in the sense the other entries sandbox their own command.
      //
      // No unix-socket grant appears here, and none is needed for docker
      // itself: exec_paths alone is what lets docker reach
      // /var/run/docker.sock — measured, `docker ps` reaches the daemon
      // from this child sandbox with no filesystem.unix_socket entry
      // anywhere in this file. The FLOOR is unix-socket mediated and
      // refuses it: `curl -s --unix-socket /var/run/docker.sock
      // http://localhost/version`, run at the floor, is refused with "no
      // matching unix_socket capability", exit 7, both before and after
      // this entry existed. Measured.
      //
      // This entry IS now the only route to the daemon, which it did not
      // used to be — read it accordingly. Tool Sandbox's child sandboxes
      // carry NO unix-socket mediation at all, so while bash, sh and go
      // were declared, the identical curl through `bash -c` or `sh -c`, and
      // a raw AF_UNIX connect from a Go program under `go run`, both
      // reached the daemon with no filesystem.unix_socket grant anywhere.
      // That gap was never about this entry — it opened the moment any
      // arbitrary-code command was declared, and it closed when those three
      // were removed (see the scope rule at the top of command_policies).
      // Measured, 3/3: with only git, ssh and docker declared, the floor
      // curl is refused (exit 7) and the Go Dial is denied.
      //
      // So the honest reading of this entry changed with that removal.
      // Before, it bounded only which command could reach the daemon under
      // the *name* docker while a side route stood open. Now nothing else
      // reaches the daemon at all, and this entry is the single grant that
      // does. Deleting it would close daemon access outright; keeping it is
      // a deliberate decision to leave a root-equivalent capability
      // reachable from the session, not an artefact. Nothing here inspects
      // what is asked of docker — see the note below.
      //
      // ~/.docker moved here from the floor's own filesystem.read (it used
      // to sit there next to `~/.orbstack`; neither path exists on this
      // host, so that floor grant conferred nothing and the
      // `bypass_protection` opt-in it required only printed a warning on
      // every run). It is one of nono's protected paths, but a child edge
      // can grant a protected path without the floor's `bypass_protection`
      // opt-in — child sandboxes have no way to express bypass_protection
      // at all, and none is needed here. Measured.
      //
      // The nix store path below carries docker's build hash and goes
      // stale the next time nixpkgs bumps the docker package; `agent-sandbox
      // doctor` checks it, same as git's exec_paths above. The two non-Nix
      // entries are portability, not redundancy: nono skips whichever
      // exec_paths entries do not exist on this host, and doctor only flags
      // an exec_paths set when EVERY entry in it is missing — so carrying
      // `/usr/libexec/docker` and `/usr/lib/docker` alongside the pinned nix
      // path costs nothing and keeps this working on a non-Nix host. Same
      // reasoning, and the same portability shape, as git's exec_paths list
      // above. The path is deliberately the `libexec/docker` directory, not
      // `bin/docker`: on NixOS, `bin/docker` is a small stub that re-execs
      // `libexec/docker/docker` by absolute path, and only the directory the
      // real binary lives under needs to be exec-reachable here.
      //
      // No argv-level policy either: this entry execs the real docker
      // binary directly, the same shape as git's own entry above. Nothing
      // inspects what is asked of docker — `--privileged`, a host-path or
      // docker-socket bind mount, and the rest are refused only insofar as
      // the child sandbox's own fs grants above refuse them. The narrowness
      // of that sandbox is the whole boundary here.
      "docker": {
        "from": { "session": { "sandbox": {
          "fs_read":    ["$WORKDIR", "/nix/store", "/run/current-system/sw", "~/.docker"],
          "fs_write":   ["$WORKDIR"],
          "exec_paths": ["/nix/store/k9xql8h1fgvf6mdj4w8h2sfqwh6jr3w2-docker-29.6.2/libexec/docker",
                         "/usr/libexec/docker", "/usr/lib/docker"],
          "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "TERM"] }
        } } }
      }
    }
  }
}

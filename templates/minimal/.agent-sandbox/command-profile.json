{
  "meta": { "name": "agent-sandbox commands (minimal)" },

  // Commands get the working directory and nothing else writable beyond
  // nono's own floor, which already grants read on /bin and /usr/bin.
  //
  // $WORKDIR as a path grant, not "workdir": { "access": "readwrite" }.
  // The workdir key makes nono ask before sharing the directory, and execd
  // runs under --silent, where nono refuses to ask. Measured on nono 0.78.0:
  // with the workdir key, execd's session exits 1 with "CWD access requires
  // --allow-cwd in non-interactive mode" before any command runs.
  "filesystem": { "allow": ["$WORKDIR"] },

  // mise-installed tools (node, go, ...) on PATH. Without it the real binary
  // under ~/.local/share/mise is unreadable, PATH falls through to mise's
  // shim, and mise fails "Operation not permitted". Same group, same reason as
  // the agent profile. Widens: every command can run any mise-installed tool
  // and read ~/.config/mise -- keep secrets out of its [env].
  "groups": { "include": ["mise_manager"] },

  // The floor for commands that have NO entry in command_policies below.
  // It reaches no host: every domain a command needs goes in that command's
  // own policy, which gets a proxy filtered by its own list (measured,
  // nono 0.80.0). Not "block": true -- nono's proxy only exists when the
  // session declares network, and without it every proxy-routed policy
  // (git, gh) fails at sandbox init. The one entry is a reserved .invalid
  // name, so it can never resolve.
  //
  // Residual: the floor still reaches api.github.com and github.com, without
  // a token (401). nono adds a credential route's upstream to this list on
  // its own, even for a route only gh's or git's sandbox receives.
  "network": {
    "allow_domain": ["placeholder.invalid"]
  },

  // DO NOT DELETE THIS BLOCK. Without an allow_vars list nono forwards the
  // environment as-is -- measured: 84 host variables reached the command,
  // SSH_AUTH_SOCK and CLAUDE_CODE_MESSAGING_TOKEN among them.
  //
  // AGENT_SANDBOX_EXECD_SOCKET must never be added here, under any name or
  // wildcard. A command that can reach the execd socket can recurse into
  // execd, which spawns handlers with no concurrency cap. Omitting it only
  // works while this block exists; delete the block and it is forwarded.
  //
  // No proxy variables here: nono injects its own at this level. They ARE
  // required inside a command policy -- see git below.
  "environment": {
    "allow_vars": ["PATH", "HOME", "USER", "TERM", "LANG", "LC_ALL"]
  },

  "command_policies": {
    // gh's token, injected only into gh's sandbox (see gh below). The proxy
    // runs `gh auth token` on the host and swaps it in on requests to
    // api.github.com; gh itself only ever sees a phantom GH_TOKEN. The host
    // needs `gh auth login` done once.
    //
    // The source runs when the session starts, and a failing source stops
    // the session -- every command, not just gh (measured, nono 0.80.0).
    // The `|| echo` keeps a host without gh, or not logged in, usable: gh
    // then gets 401 and everything else runs.
    //
    // Needs nono 0.80.0 or later. Measured on 0.78.0: with this entry, a
    // request to api.github.com from ANY command, sent with no token at all,
    // came back authenticated as the user. 0.80.0 returns 401 to the same
    // request.
    "credentials": {
      "github": {
        "type": "proxy",
        "upstream": "https://api.github.com",
        "source": { "type": "command", "command": "sh", "args": ["-c", "gh auth token 2>/dev/null || echo unavailable"] },
        "env_var": "GH_TOKEN",
        "credential_format": "token {}"
      },
      // The same token for git's HTTPS remotes, injected only into git's
      // sandbox (see git below). GitHub takes it as Basic auth with any
      // username; a command credential has no basic_auth mode, so the source
      // builds the base64 itself. git needs no credential helper: the proxy
      // injects on every request through git's own proxy, which nothing else
      // can reach (measured, nono 0.80.0).
      "github_git": {
        "type": "proxy",
        "upstream": "https://github.com",
        "source": { "type": "command", "command": "sh", "args": ["-c", "t=$(gh auth token 2>/dev/null) || t=unavailable; printf 'x-access-token:%s' \"$t\" | base64"] },
        "env_var": "NONO_GITHUB_GIT_TOKEN",
        "credential_format": "Basic {}"
      }
    },
    "commands": {
      // gh gets the github credential above and nothing else. A credential
      // route reaches its upstream without a network key or a session
      // allow_domain entry (measured, nono 0.80.0).
      //
      // Residual: gh can call any GitHub API endpoint as the user -- the
      // endpoint_policy allows everything. Narrow it with "allow" rules if
      // that is too much.
      "gh": {
        // gh runs git to find the repository (`gh pr list` in a checkout).
        "can_use": ["git"],
        "from": {
          "session": { "sandbox": {
            // nono refuses a proxy credential granted without an
            // endpoint_policy -- at run time, not in `profile validate`.
            "credentials":  [{ "name": "github", "endpoint_policy": { "default": "allow" } }],
            // nono's shim that hands off to git runs in THIS sandbox and must
            // resolve the cwd. Measured on macOS, nono 0.80.0: without it
            // `gh pr list` fails "command-mediation shim cwd failed".
            "fs_read":      ["$WORKDIR"],
            "environment":  {
              "allow_vars": ["PATH", "HOME", "USER", "TERM", "LANG", "LC_ALL"],
              // gh refuses to start when ~/.config/gh exists but is
              // unreadable, and it must stay unreadable: hosts.yml can hold
              // a plaintext token. A missing config dir is fine to gh.
              // Costs gh aliases and settings.
              "set_vars": { "GH_CONFIG_DIR": "/nonexistent/gh" }
            }
          } }
        }
      },

      // git gets its own child sandbox. Without an entry here git is not
      // merely unconfined, it is broken: at execd's own grants it cannot read
      // ~/.gitconfig and every invocation dies with
      // "fatal: unknown error occurred while reading the configuration files".
      //
      // Remotes are HTTPS only, and only GitHub. SSH remotes are rewritten to
      // HTTPS in this sandbox alone (GIT_CONFIG_* below); the host's own git
      // config and the repository's remote URLs are untouched. ssh is denied
      // outright below.
      "git": {
        "from": {
          // Read-only and offline: enough for gh to read remotes and the
          // current branch. Commands that make gh push or clone through git
          // (`gh pr create` pushing, `gh repo clone`) are refused.
          "gh": { "sandbox": {
            "fs_read_file": ["@git:config-files"],
            "fs_read":      ["$WORKDIR", "@git:common-dir"]
          } },
          "session": { "sandbox": {
            // @git: tokens are resolved by nono per repository. Include
            // scopes are excluded, so a repository cannot grant itself host
            // access through its own .git/config.
            //
            // HTTPS transport also needs the system CA bundle. The two
            // paths are Debian/Ubuntu and Fedora/Arch; nono skips an entry
            // that does not exist.
            "fs_read_file": ["@git:config-files",
                             "/etc/ssl/certs/ca-certificates.crt",
                             "/etc/pki/tls/certs/ca-bundle.crt"],
            // A helper under exec_paths below runs only if it is ALSO
            // readable here, because a read grant is what carries execute
            // in a child sandbox. Its shared libraries (libcurl for
            // git-remote-https) must be readable too; git's own library
            // closure does not cover them. Measured on nono 0.78.0: without
            // the git-core dir, "cannot exec 'remote-https': Permission
            // denied"; without the library dir, "libcurl-gnutls.so.4: cannot
            // open shared object file". Missing entries are skipped, so the
            // list covers x86_64/aarch64 Debian-style and lib64 layouts.
            "fs_read":      ["@git:hooks-path", "$WORKDIR",
                             "/usr/lib/git-core", "/usr/libexec/git-core",
                             "/usr/lib/x86_64-linux-gnu", "/usr/lib/aarch64-linux-gnu",
                             "/usr/lib64"],
            // @git:common-dir covers the object store when $WORKDIR is a
            // linked worktree; @git:worktree covers the main repo root,
            // without which `git worktree add` fails at getcwd() with EPERM.
            "fs_write":     ["$WORKDIR", "@git:common-dir", "@git:worktree", "@git:toplevel"],
            // git-remote-https and the other subcommands live here. nono
            // SKIPS entries that do not exist, so a wrong path costs
            // availability, silently. On NixOS add the output of
            // `git --exec-path` (here AND in fs_read above); these two cover
            // ordinary Linux.
            "exec_paths":   ["/usr/lib/git-core", "/usr/libexec/git-core"],
            // macOS ignores exec_paths: a child may exec only its own binary,
            // so git cannot start git-remote-https and every HTTPS remote
            // fails "cannot exec 'git-remote-https': Operation not permitted".
            // These rules re-allow exec of git's helper directory for Xcode
            // and the Command Line Tools; Linux ignores them. Do not add
            // fs_read on the Xcode tree as well -- measured, that breaks
            // /usr/bin/git's xcrun lookup ("unable to locate xcodebuild").
            // `nono profile validate` warns [unsafe_seatbelt_rules] here.
            "unsafe_macos_seatbelt_rules": [
              "(allow process-exec* (subpath \"/Applications/Xcode.app/Contents/Developer/usr/libexec/git-core\"))",
              "(allow process-exec* (subpath \"/Library/Developer/CommandLineTools/usr/libexec/git-core\"))"
            ],
            // The token reaches github.com through this route and git has no
            // network key, so github.com is the only host git reaches.
            //
            // Residual: git can push to, and read, any repository the token
            // can. The rules allow git's smart-HTTP endpoints only, not the
            // rest of github.com; name repositories ("/<owner>/<repo>.git/
            // info/refs", ...) to narrow further. A repository not named then
            // fails 403 -- public clones included (measured, nono 0.80.0).
            "credentials":  [{ "name": "github_git", "endpoint_policy": { "default": "deny", "allow": [
              { "method": "GET",  "path": "/*/*/info/refs" },
              { "method": "POST", "path": "/*/*/git-upload-pack" },
              { "method": "POST", "path": "/*/*/git-receive-pack" }
            ] } }],
            // The proxy variables are load-bearing HERE, unlike at session
            // level. Measured: without them `git ls-remote https://...` fails
            // with "unable to access"; with them it returns the ref.
            "environment":  {
              "allow_vars": [
                "PATH", "HOME", "USER", "TERM", "LANG", "LC_ALL",
                "http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY",
                "no_proxy", "NO_PROXY"
              ],
              // Config for this sandbox alone, layered over the user's. The
              // empty helper clears inherited ones (osxkeychain cannot run
              // here); the two rewrites send SSH remotes over HTTPS.
              "set_vars": {
                "GIT_CONFIG_COUNT": "3",
                "GIT_CONFIG_KEY_0": "credential.helper",
                "GIT_CONFIG_VALUE_0": "",
                "GIT_CONFIG_KEY_1": "url.https://github.com/.insteadOf",
                "GIT_CONFIG_VALUE_1": "git@github.com:",
                "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
                "GIT_CONFIG_VALUE_2": "ssh://git@github.com/"
              }
            }
          } }
        }
      },

      // No command reaches ssh. git's SSH remotes go over HTTPS (above), so
      // nothing needs it; without this entry ssh would still run at the floor
      // and fail on ~/.ssh and the network, with no reason given. A deny edge
      // builds no sandbox.
      "ssh": { "from": { "session": "deny" } }
    }
  }
}
